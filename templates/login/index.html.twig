{% extends 'base.html.twig' %}


{% block title %}Connexion | Corpus Humanum{% endblock %}

{% block body %}
<style>

</style>
<div class="container p-lg-5 my-5">

    <div >
        <div class="m-5">
            <h1 class="text-center pb-5 fw-bold">Connexion</h1>
            <div class="row d-flex align-items-center justify-content-center">
                
            
                <div class=" d-grid gap-3 col-lg-6">

                    <a href="{{ path('login') }}" target="_blank" class="btn btn-dark rounded-0 text-light" aria-label="Contactus">
                        Connexion par l'ENT
                        <span data-toggle="tooltip" data-placement="right" title="Connectez-vous par votre compte CAS de l'UPVM">
                        <i class="fa fa-info-circle"></i>
                    </a>
                        
                    <a href="{{ path('login2') }}" target="_blank" class="btn btn-dark rounded-0 text-light" aria-label="Contactus">
                        Connexion par HAL
                        <span data-toggle="tooltip" data-placement="right" title="Connectez-vous via votre compte HAL">
                        <i class="fa fa-info-circle"></i>
                    </a>

                    <a href="/connect/orcid" target="_blank" class="btn btn-dark rounded-0 text-light" aria-label="Contactus">
                        Connexion par ORCID
                        <span data-toggle="tooltip" data-placement="right" title="Connectez-vous par votre compte ORCID">
                        <i class="fa fa-info-circle"></i>
                    </a>

                </div>


            </div>
            
        </div>
    </div>

</div>
{% endblock %}
